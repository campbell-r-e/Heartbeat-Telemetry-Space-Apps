# Copy to web/.env.local (gitignored) for `npm run dev -w web`.
# Both values are read only on the Next.js server; neither is sent to the browser.

# The onboard server (docker compose publishes it on port 4000).
HEARTBEAT_SERVER_URL=http://localhost:4000

# The same shared write token as HEARTBEAT_TOKEN in the repo root's .env. The dashboard's
# server actions add it to POST/PUT/DELETE requests (meals, check-ins, the surgeon console's
# actions and its simulated storm control). Without it every write fails.
HEARTBEAT_TOKEN=change-me
