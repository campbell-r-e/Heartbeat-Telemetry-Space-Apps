# Copy to .env (which is gitignored) and replace both values. docker compose reads .env itself.
# Generate a value with: openssl rand -hex 24

# Password for the Postgres "heartbeat" user. The server container uses it, and so does any
# tool on this Mac connecting to localhost:5432 (e.g. TablePlus, or the server run outside Docker).
POSTGRES_PASSWORD=change-me

# Shared token the watch and dashboard send on every POST/PUT/DELETE:
#   Authorization: Bearer <HEARTBEAT_TOKEN>
HEARTBEAT_TOKEN=change-me
